// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  SUPERVISOR
  COORDINATOR
}

enum StudentStatus {
  ACTIVE
  PENDING
  COMPLETED
  INACTIVE
}

enum AttendanceStatus {
  PENDING
  APPROVED
  DECLINED
}

enum EstablishmentStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Login name issued by the coordinator. Nullable because accounts created
  // before this existed have none — those still sign in with their email.
  // Logging in accepts either, so a username may never contain "@", which is
  // what keeps the two namespaces from colliding.
  username  String?  @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  studentProfile     Student?
  supervisorProfile  Supervisor?
  coordinatorProfile Coordinator?

  conversations ConversationParticipant[]
  messagesSent  Message[]
}

model Establishment {
  id                       String              @id @default(cuid())
  name                     String
  industryType             String?
  streetAddress            String?
  region                   String?
  barangay                 String?
  city                     String?
  province                 String?
  zipCode                  String?
  status                   EstablishmentStatus @default(ACTIVE)
  coordinatorFirstName     String?
  coordinatorLastName      String?
  coordinatorMiddleInitial String?
  coordinatorAge           Int?
  coordinatorGender        String?
  coordinatorPosition      String?
  coordinatorAddress       String?
  coordinatorContact       String?
  coordinatorEmail         String?
  createdAt                DateTime            @default(now())

  supervisors Supervisor[]
  students    Student[]
}

model Supervisor {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id])
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  position        String?

  attendanceApprovals Attendance[] @relation("ApprovedBy")
  evaluations         Evaluation[]
}

model Coordinator {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  reviewedDocuments Document[]
}

model Student {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  studentIdNumber String         @unique
  course          String?
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  requiredHours   Int            @default(0)
  startDate       DateTime?
  status          StudentStatus  @default(ACTIVE)

  // Personal details captured by the coordinator's student form. All nullable
  // because every student created before this migration has none of them.
  // `age` is stored alongside `dateOfBirth` rather than derived, matching how
  // Establishment already stores `coordinatorAge`.
  firstName     String?
  lastName      String?
  middleInitial String?
  age           Int?
  dateOfBirth   DateTime?
  school        String?
  contactNumber String?
  address       String?
  yearLevel     String?
  gender        String?
  endDate       DateTime?

  attendances Attendance[]
  documents   Document[]
  credentials Credential[]
  evaluations Evaluation[]
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  date      DateTime
  timeInAM  DateTime?
  timeOutAM DateTime?
  timeInPM  DateTime?
  timeOutPM DateTime?
  remarks   String?
  status    AttendanceStatus @default(PENDING)

  // Why a supervisor declined. Kept separate from `remarks`, which belongs to
  // the student — the prototype overwrote the student's note with the decline
  // reason, losing what they had written.
  declineReason String?

  approvedById String?
  approvedBy   Supervisor? @relation("ApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())

  // One log per student per day. Without this a student can submit the same
  // day repeatedly and every hours total counts it more than once.
  // `date` is normalised to UTC midnight on write (see StudentService), which
  // is what makes the constraint meaningful.
  @@unique([studentId, date])
}

model Document {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  name      String
  fileUrl   String
  status    String  @default("PENDING")

  // Who actioned this review, their note, and when. `reviewNote` is required
  // by the service when status is REJECTED, mirroring
  // Attendance.declineReason; unlike Attendance.approvedById, this column is
  // named for what it actually means — the reviewer, not just "who approved".
  reviewedById String?
  reviewedBy   Coordinator? @relation(fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  uploadedAt DateTime @default(now())
}

model Credential {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  type      String
  fileUrl   String
  createdAt DateTime @default(now())
}

model Evaluation {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  supervisorId String
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id])

  // The school's official ON-THE-JOB TRAINING PERFORMANCE EVALUATION SHEET:
  // nineteen items, each scored 1-5 (5 OUTSTANDING ... 1 NEEDS IMPROVEMENT),
  // in four sections. Columns are named by meaning rather than by the form's
  // letters so the code stays readable; the letters, labels and per-section
  // maximums live in src/common/evaluation-scoring.ts, which is the only place
  // that knows how the items add up.
  //
  // No uniqueness constraint on (studentId, supervisorId): a student is
  // deliberately evaluated more than once.

  // I. WORK ATTITUDES AND HABITS (25 points)
  courtesy                 Int
  patienceAndDiligence     Int
  punctualityAndAttendance Int
  neatnessOfReports        Int
  punctualityOfReports     Int

  // II. WORK KNOWLEDGE (20 points)
  technicalKnowledge      Int
  relatesTheoryToPractice Int
  openToCriticism         Int
  discretion              Int

  // III. PERSONALITY AND PERSONAL APPEARANCE (25 points)
  neatAndWellGroomed     Int
  properAttire           Int
  poiseAndSelfConfidence Int
  emotionalMaturity      Int
  dealsWellWithCoworkers Int

  // IV. PROFESSIONAL COMPETENCE (25 points)
  performanceOfWork       Int
  understandsInstructions Int
  sharesSuggestions       Int
  ethicalStandards        Int
  speaksAudibly           Int

  // The form's TOTAL RATING: the raw sum of the nineteen items, so always
  // 19-95. Computed and stored server-side, never accepted from the client.
  // Deliberately raw — the form has no percentage, letter grade or performance
  // band, and the old Excellent/Very Good/Good/Fair/Poor labels were retired
  // with the previous rubric.
  totalRating Int

  // The form's header fields. `trainingEmployedAt`, `evaluatorName` and
  // `evaluatorPosition` are snapshots taken when the evaluation is written, so
  // renaming or deleting a supervisor later cannot rewrite a signed record.
  trainingStartedAt  DateTime?
  trainingEndedAt    DateTime?
  trainingEmployedAt String?
  evaluatorName      String?
  evaluatorPosition  String?

  comments        String?
  recommendations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  name      String?
  createdBy String
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())
}
